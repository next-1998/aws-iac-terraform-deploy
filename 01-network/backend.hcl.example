# 00-bootstrap 실행 후 `terraform output backend_hcl_example` 값을 참고해 backend.hcl로 복사합니다.
bucket       = "<접두어>-s3-tfstate-01"   # 예: hw-iac-dev-an2-s3-tfstate-01 (00-bootstrap naming)
key          = "<site>/01-network/terraform.tfstate"
region       = "ap-northeast-2"
encrypt      = true
use_lockfile = true
